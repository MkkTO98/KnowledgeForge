# KnowledgeForge PostgreSQL projection configuration example
# No secrets are stored here.
# Local peer-authenticated PostgreSQL on this host uses the current OS user by default.

# Optional override for tools/postgresql_operational_projection.py.
KNOWLEDGEFORGE_PG_DATABASE=knowledgeforge

# Optional libpq variables may be supplied in the shell environment when needed.
# Do not commit credentials.
# PGHOST=/var/run/postgresql
# PGPORT=5432
# PGUSER=mkkto
# PGPASSWORD=<do-not-commit>
